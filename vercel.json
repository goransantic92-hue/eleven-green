{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/eleven-green", "destination": "/", "permanent": true },
    { "source": "/eleven-green/", "destination": "/", "permanent": true },
    { "source": "/eleven-green/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/tron", "destination": "/tron/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/((?!tron/).*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|css|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    }
  ]
}
