{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tron-fast-food.vercel.app"
        }
      ],
      "destination": "https://eleven-green-concept.vercel.app/",
      "permanent": true
    },
    {
      "source": "/tron",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tron/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/eleven-green",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/eleven-green/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/eleven-green/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
